{
  "config_version": 8,
  "active_profile_id": "default",
  "auto_switch": true,
  "global": {
    "browser": {
      "headless": true,
      "browser_channel": "msedge",
      "browser_custom_path": "",
      "custom_browser_engine": "chromium",
      "persistent_context": false,
      "pure_mode": true,
      "stealth_mode": true,
      "stealth_custom_script": "",
      "low_resource_mode": false,
      "disable_web_security": false,
      "browser_args": "",
      "viewport_width": 1280,
      "viewport_height": 720,
      "locale": "zh-CN",
      "timezone_id": "Asia/Shanghai",
      "ignore_https_errors": true,
      "user_agent": "",
      "extra_headers_json": "",
      "timeout": 30,
      "navigation_timeout": 15,
      "login_timeout": 120,
      "bind_proxy": ""
    },
    "monitor": {
      "check_interval": 120,
      "tcp_targets": [
        "8.8.8.8:53",
        "114.114.114.114:53",
        "www.baidu.com:443"
      ],
      "http_targets": [
        "http://connect.rom.miui.com/generate_204",
        "http://connectivitycheck.platform.hicloud.com/generate_204",
        "http://wifi.vivo.com.cn/generate_204"
      ],
      "url_targets": [
        "http://captive.apple.com/hotspot-detect.html",
        "http://detectportal.firefox.com/success.txt",
        "http://www.msftconnecttest.com/connecttest.txt"
      ],
      "url_expected_responses": {
        "http://detectportal.firefox.com/success.txt": "success",
        "http://www.msftconnecttest.com/connecttest.txt": "Microsoft Connect Test",
        "http://captive.apple.com/hotspot-detect.html": "Success"
      },
      "tcp_enabled": false,
      "http_enabled": true,
      "url_enabled": false,
      "local_check_enabled": false,
      "disable_proxy": true,
      "profile_check_interval": 180,
      "tcp_timeout": 2,
      "http_timeout": 10,
      "url_timeout": 10,
      "auth_url_timeout": 5,
      "check_auth_url": false,
      "post_login_delay": 5
    },
    "pause": {
      "enabled": false,
      "start_hour": 0,
      "start_minute": 0,
      "end_hour": 0,
      "end_minute": 0
    },
    "logging": {
      "level": "INFO",
      "file_enabled": true,
      "retention_days": 7
    },
    "retry_settings": {
      "max_retries": 3,
      "retry_interval": 5
    },
    "worker": {
      "idle_timeout_seconds": 300,
      "keep_alive": false
    },
    "app": {
      "auto_start_browser": true,
      "runtime_mode": "full",
      "startup_action": "monitor",
      "port": 50721,
      "autostart_enabled": true,
      "task_notification": true,
      "developer_mode": false,
      "show_tray": true,
      "auto_restart_hours": 24
    },
    "updater": {
      "check_on_startup": true,
      "auto_check_enabled": true,
      "channel": "stable",
      "release_source_url": "https://api.github.com/repos/Misyra/Campus-Auth-rs/releases/latest",
      "check_interval_hours": 24,
      "use_proxy": false,
      "proxy_url": "http://127.0.0.1:7890",
      "proxy_port": 7890
    }
  }
}